# Production Environment Template
# Copy relevant values to your hosting provider's environment variables

APP_NAME=TrotinetteApp
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-backend-domain.com
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate_--show

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Database - Use DATABASE_URL or individual vars
# Option 1: Connection URL (PlanetScale, Neon, Supabase)
DATABASE_URL=mysql://user:password@host:port/database?sslmode=require

# Option 2: Individual vars (Railway MySQL)
DB_CONNECTION=mysql
DB_HOST=your-db-host
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=your-password

# Session & Cache (use database for distributed env)
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# Queue (use sync for serverless, database for Railway/Render)
QUEUE_CONNECTION=sync

# File Storage (REQUIRED - choose one)
# Option 1: Cloudinary (Recommended - 25GB free)
FILESYSTEM_DISK=cloudinary
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Option 2: AWS S3
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=your-bucket
# AWS_URL=https://your-bucket.s3.amazonaws.com

# CORS & Sanctum
FRONTEND_URL=https://your-frontend.vercel.app
SANCTUM_STATEFUL_DOMAINS=your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CORS_SUPPORTS_CREDENTIALS=true

# Mail (Optional - use Mailtrap, SendGrid, etc)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-username
MAIL_PASSWORD=your-password
MAIL_FROM_ADDRESS=noreply@trotinette.com
MAIL_FROM_NAME="${APP_NAME}"
